NODE_ENV=development
PORT=4000

# Local MongoDB (e.g. `docker run -d -p 27017:27017 --name doctor-tracker-mongo mongo:8.0`)
# or a MongoDB Atlas connection string.
MONGODB_URI=mongodb://localhost:27017/doctor-tracker-2

# At least 32 characters. Generate one with: openssl rand -base64 48
# The client (Next.js proxy) must use the SAME value to verify the session cookie.
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
SESSION_TTL_DAYS=7
COOKIE_NAME=dt_session

# Comma-separated list of allowed browser origins (production: your Vercel URL, no trailing slash).
CLIENT_ORIGIN=http://localhost:3000
# Express "trust proxy" setting: number of proxy hops in front of the API (Next.js rewrite = 1).
TRUST_PROXY=1

# Accounts created by `npm run seed`
SEED_ADMIN_NAME=Shahana Alam
SEED_ADMIN_EMAIL=admin@doctortracker.app
SEED_ADMIN_PASSWORD=Admin@12345
SEED_STAFF_EMAIL=staff@doctortracker.app
SEED_STAFF_PASSWORD=Staff@12345
